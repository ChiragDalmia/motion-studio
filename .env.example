# Optional AUTHORING providers. Never read by build, check or gate2.
# A cache miss is a build failure, not a fetch.
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# Must stay UNSET. If set, bundleToSingleHtml emits <script src> instead of
# inlining the runtime, silently turning the artifact into a CDN-dependent file.
# tools/build.mjs asserts this is empty and refuses to run otherwise.
HYPERFRAME_RUNTIME_URL=
