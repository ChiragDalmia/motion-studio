  "vo": [
    {
      "start": 0.9,
      "end": 4.2,
      "text": "Know where your learners stand before exam day."
    },
    {
      "start": 4.7,
      "end": 10.3,
      "text": "ReadyEngine is an online platform that personalizes exam preparation and makes each learner\u2019s readiness visible."
    },
    {
      "start": 10.9,
      "end": 19.1,
      "text": "ReadyRating shows readiness on a scale of one to five, based on each learner\u2019s demonstrated understanding of the concepts their exam requires."
    },
    {
      "start": 19.55,
      "end": 23,
      "text": "The breakdown shows which concepts need more practice."
    },
    {
      "start": 23.6,
      "end": 25.1,
      "text": "Here\u2019s how it works."
    },
    {
      "start": 25.85,
      "end": 30.75,
      "text": "As learners answer practice questions, ReadyEngine identifies where they need more support."
    },
    {
      "start": 31.5,
      "end": 39.3,
      "text": "That shapes a study plan around their needs and exam date, with lessons and practice focused on what to work on next."
    },
    {
      "start": 40.3,
      "end": 44.7,
      "text": "Practice exams are aligned to the concepts covered on the exam."
    },
    {
      "start": 45.7,
      "end": 51.3,
      "text": "Learners can ask questions and get explanations through Riley, their 24/7 study assistant."
    },
    {
      "start": 52.3,
      "end": 57.8,
      "text": "ReadyEngine keeps checking. It looks for understanding demonstrated more than once, without help."
    },
    {
      "start": 58.35,
      "end": 62,
      "text": "As learners practise, their study plan and ReadyRating update."
    },
    {
      "start": 62.45,
      "end": 65.85,
      "text": "Concepts that need more attention return to the plan."
    },
    {
      "start": 66.9,
      "end": 74.7,
      "text": "Help learners focus their preparation, and give your team a clearer view of where support is needed before exam day."
    },
    {
      "start": 75.9,
      "end": 78.6,
      "text": "ReadyEngine. Know when you\u2019re ready."
    },
    {
      "start": 79,
      "end": 81.2,
      "text": "Powered by We Know Training."
    },
    {
      "start": 81.7,
      "end": 85.1,
      "text": "Talk to WKT about ReadyEngine for your program."
    }
  ],
