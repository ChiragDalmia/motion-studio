node_modules/
.env
tmp/

# Editor and OS droppings. tools/guard.mjs fails if one is ever tracked.
.DS_Store
Thumbs.db
.vscode/
.idea/
*.local
*.local.*
*.orig
*.rej
*.bak
*.swp
npm-debug.log*

VideoContext
# Generated by tools/prepare.mjs from film.json + beats.html.
# tools/clean.mjs removes exactly these and nothing else.
work/*/*/index.html
work/*/*/compositions/
work/*/*/media/
work/*/*/brand.css
work/*/*/gsap.min.js
work/*/*/captions.vtt
work/*/*/index.motion.json
work/*/*/prepared.json
work/*/*/snapshots/
work/*/*/renders/
work/*/*/voice-samples/

# Generated by tools/tokens.mjs from brands/*/brand.ts.
brands/*/tokens.json
brands/*/surfaces.css
brands/*/gfx.catalog.md

# Audio masters and mixes. Generated by a provider or by ffmpeg, entropy-coded
# so git deltas achieve nothing, and regenerating one produces a different
# film. The brief and the manifest are tracked; the bytes are not.
audio/projects/*/source/
audio/projects/*/generated/
dist/
